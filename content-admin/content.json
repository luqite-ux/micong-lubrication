        "faq": {
          "hidden": false,
          "values": {
            "title": {
              "en": "Questions buyers ask first"
            },
            "description": {
              "en": "Answers on product fit, packaging, samples, pricing, timing and inspection."
            },
            "items": [
              {
                "id": "faq-5",
                "question": {
                  "en": "Can packaging be customized?"
                },
                "answer": {
                  "en": "Packaging customization can be discussed. Tell us the pack type and your requirements so we can confirm the options for your order."
                }
              },
              {
                "id": "faq-6",
                "question": {
                  "en": "Can I request a sample?"
                },
                "answer": {
                  "en": "Yes. Send the product family, grade if listed, quantity and destination with your request."
                }
              },
              {
                "id": "faq-7",
                "question": {
                  "en": "Can I request a technical data sheet or test report?"
                },
                "answer": {
                  "en": "Yes. Ask for the document relevant to the product family and grade; we will confirm the available material."
                }
              },
              {
                "id": "faq-8",
                "question": {
                  "en": "Which applications do you cover?"
                },
                "answer": {
                  "en": "Our listed families include products for hydraulic equipment and CNC machining. Describe your machine and operating conditions so we can discuss the relevant family."
                }
              },
              {
                "id": "faq-9",
                "question": {
                  "en": "Can we discuss OEM or ODM cooperation?"
                },
                "answer": {
                  "en": "Yes. Share the product family, branding and packaging requirements for review."
                }
              },
              {
                "id": "faq-13",
                "question": {
                  "en": "Does a quoted price include packaging, tax and shipping?"
                },
                "answer": {
                  "en": "Packaging and tax are included; shipping is excluded. Confirm the scope on the specific quotation."
                }
              },
              {
                "id": "faq-14",
                "question": {
                  "en": "Are long-term or bulk pricing terms available?"
                },
                "answer": {
                  "en": "Long-term cooperation and bulk pricing can be discussed against the order and quantities."
                }
              },
              {
                "id": "faq-15",
                "question": {
                  "en": "Can prices change with oil prices or exchange rates?"
                },
                "answer": {
                  "en": "Industrial-oil prices may change with international oil-price movements. Request a current quotation for your order."
                }
              },
              {
                "id": "faq-16",
                "question": {
                  "en": "Can samples be shipped?"
                },
                "answer": {
                  "en": "Yes. Samples can be shipped, with shipping paid by the customer. Provide the destination to discuss delivery."
                }
              },
              {
                "id": "faq-17",
                "question": {
                  "en": "Are samples charged or refundable?"
                },
                "answer": {
                  "en": "Small samples may be free; larger samples are charged. Samples are non-refundable, and shipping is excluded. Confirm the sample size and charges before dispatch."
                }
              },
              {
                "id": "faq-18",
                "question": {
                  "en": "How long does a sample take?"
                },
                "answer": {
                  "en": "Sample preparation is listed at approximately one week. Confirm the timing for the requested product and destination."
                }
              },
              {
                "id": "faq-19",
                "question": {
                  "en": "Can a sample be approved before a larger order?"
                },
                "answer": {
                  "en": "Yes. Sample confirmation before a larger order can be discussed; include the approval steps you need in your inquiry."
                }
              },
              {
                "id": "faq-20",
                "question": {
                  "en": "Will a sample represent the larger order?"
                },
                "answer": {
                  "en": "Sample size and what it should represent depend on your requirements. Some buyers request a small sample; confirm the comparison and approval criteria before the larger order."
                }
              },
              {
                "id": "faq-21",
                "question": {
                  "en": "What is the lead time after ordering?"
                },
                "answer": {
                  "en": "Lead time depends on order size and is agreed for each order. Include your quantity and destination in the inquiry."
                }
              },
              {
                "id": "faq-22",
                "question": {
                  "en": "Is bulk-order delivery timing stable?"
                },
                "answer": {
                  "en": "It is generally stable, but the schedule should be confirmed for the actual quantity and order."
                }
              },
              {
                "id": "faq-23",
                "question": {
                  "en": "Can peak seasons change the schedule?"
                },
                "answer": {
                  "en": "It depends on the situation. Ask for a current lead-time estimate when you plan the order."
                }
              },
              {
                "id": "faq-24",
                "question": {
                  "en": "Can an urgent order be arranged?"
                },
                "answer": {
                  "en": "Urgent supply can be discussed when stock is available. Share your required date and quantity for confirmation."
                }
              },
              {
                "id": "faq-25",
                "question": {
                  "en": "Can I get production progress updates?"
                },
                "answer": {
                  "en": "Progress can be communicated by phone. Agree the update contact and timing with the team."
                }
              },
              {
                "id": "faq-26",
                "question": {
                  "en": "Is there a quality-control process?"
                },
                "answer": {
                  "en": "Yes. Request the inspection details relevant to your product and order."
                }
              },
              {
                "id": "faq-27",
                "question": {
                  "en": "Can a third party inspect the goods?"
                },
                "answer": {
                  "en": "Yes, third-party inspection can be discussed. State what needs to be inspected in the inquiry."
                }
              },
              {
                "id": "faq-28",
                "question": {
                  "en": "Can inspection or quality reports be provided?"
                },
                "answer": {
                  "en": "Reports can be provided. Request the specific report for your product and order."
                }
              }
            ]
          }
        },
